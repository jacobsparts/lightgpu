target/

# The lock is not tracked: this is a library plus binaries that consume it by
# git, and the point is to build against the toolkit as it stands rather than a
# frozen revision. Cargo resolves the current tip on every build. The pattern
# is unanchored, so it covers build-support/Cargo.lock as well, and Cargo keeps
# only one lock per workspace - the root one, which this ignores.
Cargo.lock
